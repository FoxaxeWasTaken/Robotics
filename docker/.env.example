# Copy to docker/.env and edit: cp .env.example .env

# ROS 2 domain: the team's value (2-99 asked by the course, ticket 0.2a). Use a distinct value per group sharing a machine/network.
ROS_DOMAIN_ID=69

# Set to true for simulation, false for real hardware
USE_SIM=true

# Phase 2: true starts the Connect Four game in place of the pick & place, in simulation only: the game's scene
# in the driver, the board reader in the perception container. `tools/so101 up` applies it, and so does
# `CONNECT4=true tools/so101 up` with no edit here; `tools/so101 restart` does not: a restarted container
# keeps the environment it was created with.
CONNECT4=false

# -- USE_SIM=false --

# Host serial port of the arm. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# Real arm only: absolute path to the calibration file, no ~ (tools/so101-arm calibrate writes it,
# docs/project/07 §3.1). Mounted read-only in the control container at /calibration/arm.json. Left commented in
# simulation: with a path that does not exist, Docker creates it as a folder owned by root.
# CALIBRATION_FILE=/home/<user>/.cache/huggingface/lerobot/calibration/robots/so_follower/my_awesome_follower_arm.json
