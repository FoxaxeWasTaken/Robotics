# Copy to docker/.env and edit: cp .env.example .env

# ROS 2 domain: the team's value (2-99 asked by the course, ticket 0.2a). Use a distinct value per group sharing a machine/network.
ROS_DOMAIN_ID=69

# Set to true for simulation, false for real hardware
USE_SIM=true

# -- USE_SIM=false --

# Host serial port of the arm. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# Absolute path to the calibration file, no ~ (tools/so101-arm calibrate writes it, docs/project/07 §3.1).
# Mounted read-only in the control container at /calibration/arm.json
CALIBRATION_FILE=/home/<user>/.cache/huggingface/lerobot/calibration/robots/so_follower/my_awesome_follower_arm.json
