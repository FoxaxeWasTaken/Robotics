# PERCEPTION container — ROS2 Jazzy + OpenCV
# Minimal on purpose: add what you need
# (YOLO/ultralytics, etc.) in your own layer.
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-image-transport \
    && rm -rf /var/lib/apt/lists/*

# Versions: docker/constraints.txt (ticket 0.3e), shared with the control image.
COPY docker/constraints.txt /opt/constraints.txt
RUN pip install --break-system-packages --no-cache-dir -c /opt/constraints.txt "opencv-python-headless==4.10.*"

# To extend this image:
# FROM tek5/perception
# RUN pip install --break-system-packages --no-cache-dir \
#    ultralytics "numpy<2" "opencv-python==4.10.*"

# Test tooling (ticket 0.3d): property tests, coverage, and one free ROS_DOMAIN_ID per colcon test job
# (colcon-ros-domain-id-coordinator: tests never see a stack running on the team's domain).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-hypothesis \
    python3-pytest-cov \
    python3-colcon-ros-domain-id-coordinator \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && bash"]
