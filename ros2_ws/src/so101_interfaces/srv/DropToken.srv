# Sim only: the simulated person drops a token into a column of the Connect Four grid (phase2/P2-02 §7).
uint8 HUMAN=1  # a token of the person's color
uint8 ROBOT=2  # a token of the robot's color: the layout's token.robot_color, yellow as installed
uint8 column   # 0 to 6, column 0 nearest the arm
uint8 color    # HUMAN or ROBOT
---
bool success   # false: unknown column or color, full column, no spare token
string message
