#!/usr/bin/env bash
# so101 - the everyday commands of the stack (docs/project/13 §1), from anywhere in the repository.
# Each prints the docker compose command it runs; --dry-run only prints. USE_SIM=false in docker/.env runs the real
# arm, after the checklist of docs/project/07 §7; bench and robustness are simulation tools. Tested by tools/ci/test_so101.sh.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
compose=(docker compose -f "$root/docker/docker-compose.yml")
BENCH_DOMAIN=77  # the bench's own ROS domain: the ground truth never reaches the everyday stack's (C-06)
ROBUSTNESS_DOMAIN=78  # the robustness demo's own ROS domain (results/robustness_demo.md)
RUN_DOMAIN=79  # tools/so101 run's domain; its container has no network anyway
PACKAGES="so101_common so101_driver so101_brain so101_perception so101_bringup so101_connect4"  # ours, each with tests
dry=false

usage() {
  cat <<EOF
Usage: tools/so101 [--dry-run] <command> [options]

  build [service]       build the images (both, or control or perception); ~10 min the first time
  up [--game]           start the stack (control, perception, viz); --game (or CONNECT4=true) starts the
                        Connect Four game instead (simulation only). It never changes the mode of a
                        running stack: down first
  wait                  wait until the running stack is ready (the first start builds the workspace)
  demo                  the Connect Four game in one command: up --game, wait, play
  down                  stop it (the control container's nodes get SIGINT: the arm parks first on the real robot)
  restart [service]     restart control (default), perception or viz: reloads changed Python code
  logs [service]        follow the logs of control (default), perception or viz
  shell                 a shell in the control container, the workspace sourced
  rviz                  RViz with the project's configuration; in game mode, the game's view
  cycle                 /sim/randomize (sim only), /brain/start, then /brain_state until DONE, ERROR or STOPPED
  play                  play Connect Four against the robot from this terminal, the stack started with
                        CONNECT4=true tools/so101 up: 1 to 7 a column, ? a hint, n a new game,
                        r the robot first, e m h the level, s stop, q quit
  bench --stub|--perception|--game [-n N] [--bags DIR]
                        the evaluation bench on ROS domain $BENCH_DOMAIN, N episodes (10), in the control
                        container: --perception the real pipeline, --stub the ground truth in its place.
                        CSV in ros2_ws/eval_bench.csv; DIR is a container path (/ros2_ws/bags: ros2_ws/bags).
                        --game: N Connect Four games against a random player, 1 to 2 min each, CSV in
                        ros2_ws/eval_games.csv
  robustness <case> [--lighting NAME] [-n N]
                        a case of the robustness demo (1, 2, 3a, 3b, 4 or 5) in a new control container on
                        ROS domain $ROBUSTNESS_DOMAIN, the stack stopped; case 5: --lighting dim, N cycles (5).
                        g1 to g6: the same questions asked of a Connect Four game; g5: --lighting dim
                        g7, g8: the grid set down elsewhere between two games, then too near the arm
  run [--stack|--game] [--out DIR] '<command>'
                        <command> in a throwaway control container, next to a running stack without touching
                        it: no network, ROS domain $RUN_DOMAIN, the repository read-only at /repo, our packages
                        copied and built there; --stack starts sim.launch.py first and waits for the brain,
                        --game starts it in game mode and waits for the board reader too;
                        DIR (made if missing) is mounted at /out for what the command writes
  test [package [pytest options]]
                        build and test one package, or all of ours, in a new control container (colcon
                        test, its own free ROS domain); the options go to pytest: test so101_brain -k fsm.
                        The stack need not run; stop it for a full run (the planner's timing tests)

  --dry-run             print the command without running it
EOF
}

die() {
  echo "so101: $*" >&2
  exit 2
}

show() {  # the command as it can be pasted: an argument with spaces or shell characters in single quotes
  local out="+" arg
  for arg in "$@"; do
    [[ $arg =~ [[:space:]\"\$\&\|\;\<\>\(\)\*] ]] && arg="'$arg'"
    out+=" $arg"
  done
  echo "$out"
}

run() {
  show "$@"
  "$dry" || "$@"
}

# The workspace sourced in a control container, or why not: the first `up` builds it, minutes on a fresh clone.
# Without it, play said "the stack does not run the game" and rviz a bare "No such file" (#264).
SOURCED="[ -f /ros2_ws/install/setup.bash ] || { echo 'so101: the workspace is not built in this container yet: \
the first tools/so101 up builds it, follow it with tools/so101 logs' >&2; exit 1; }; source /ros2_ws/install/setup.bash"

ros() {  # ros [docker compose exec options] <command>: a command in the control container, workspace sourced
  local cmd=${*: -1}
  run "${compose[@]}" exec "${@:1:$#-1}" control bash -lc "$SOURCED && $cmd"
}

running_mode() {  # the CONNECT4 of the running control container; nothing when the stack is down
  local id
  id=$("${compose[@]}" ps -q control 2> /dev/null) || return 0
  [ -n "$id" ] || return 0
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$id" 2> /dev/null | sed -n 's/^CONNECT4=//p'
}

mode_name() {
  [ "$1" = true ] && echo "the Connect Four game" || echo "the pick & place"
}

none() {  # none "$@": this command takes no argument; a flag goes before the command (down --dry-run stopped the stack)
  [ $# -eq 0 ] || die "$command: no argument expected, got '$*' (--dry-run and --help go before the command)"
}

fresh() {  # fresh <command>: a command in a new control container, ROS sourced; the stack need not run
  # CONNECT4=false: a value left in docker/.env never reaches the tests (#231)
  run "${compose[@]}" run --rm --no-deps -T -e CONNECT4=false control bash -lc "source /opt/ros/jazzy/setup.bash && $1"
}

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry=true ;;
    -h | --help) usage; exit 0 ;;
    *) break ;;
  esac
  shift
done
[ $# -gt 0 ] || { usage >&2; exit 2; }
command=$1
shift

case $command in
  build)
    [[ ${1:-} =~ ^(control|perception)?$ ]] || die "build: control or perception (viz uses the control image)"
    run "${compose[@]}" build ${1:+"$1"}
    ;;
  up)
    # The mode compose would start: --game, else CONNECT4 of the environment, else of docker/.env, else the
    # pick & place. An up in another mode than the running stack's would recreate its containers: refused.
    wanted=${CONNECT4:-}
    if [ -z "$wanted" ] && [ -f "$root/docker/.env" ]; then  # a fresh clone has none
      wanted=$(sed -n 's/^CONNECT4=//p' "$root/docker/.env" | tail -n 1)
    fi
    if [ "${1:-}" = --game ]; then wanted=true; shift; fi
    none "$@"
    [ "$wanted" = true ] || wanted=false
    if ! "$dry"; then
      running=$(running_mode)
      [ -z "$running" ] || [ "$running" = "$wanted" ] \
        || die "up: the stack runs $(mode_name "$running"): tools/so101 down first"
    fi
    echo "so101 up: $(mode_name "$wanted") (CONNECT4=$wanted)"
    CONNECT4=$wanted run "${compose[@]}" up -d control perception viz
    ;;
  wait)
    none "$@"
    mode=${CONNECT4:-false}
    "$dry" || mode=$(running_mode)
    cd "$root"  # the script's compose path is relative to the repository
    CONNECT4=${mode:-false} run bash tools/ci/wait_for_stack.sh 900
    ;;
  demo)
    none "$@"
    flags=()
    ! "$dry" || flags=(--dry-run)
    "$0" "${flags[@]}" up --game
    "$0" "${flags[@]}" wait
    exec "$0" "${flags[@]}" play
    ;;
  down)
    none "$@"
    run "${compose[@]}" down
    ;;
  restart)
    [[ ${1:-control} =~ ^(control|perception|viz)$ ]] || die "restart: control, perception or viz"
    run "${compose[@]}" restart "${1:-control}"
    ;;
  logs)
    [[ ${1:-control} =~ ^(control|perception|viz)$ ]] || die "logs: control, perception or viz"
    run "${compose[@]}" logs -f "${1:-control}"
    ;;
  shell)
    none "$@"
    ros "exec bash"
    ;;
  rviz)
    none "$@"
    ros "rviz2 -d /ros2_ws/install/so101_bringup/share/so101_bringup/rviz/\$([ \"\$CONNECT4\" = true ] && echo connect4 || echo so101).rviz"
    ;;
  cycle)
    none "$@"
    # After an ERROR, /brain/start only re-arms (06 §3.1): one call to come back to IDLE first. A service call
    # whose answer is lost would wait forever (#141): 30 s each. The filter reads line by line in bash: the image's
    # awk (mawk) reads a pipe in blocks, so it saw DONE only when the echo ended, at its timeout (#164, #169).
    call="timeout 30 ros2 service call"
    ros -T "[ \"\$CONNECT4\" != true ] || { echo 'so101 cycle: the stack runs the game (CONNECT4=true): tools/so101 down, then up' >&2; exit 1; }; \
state=\$(timeout 30 ros2 topic echo --once --field data /brain_state std_msgs/msg/String | head -n 1); \
case \$state in ERROR*) $call /brain/start std_srvs/srv/Trigger > /dev/null ;; esac; \
{ [ \"\$USE_SIM\" = false ] || $call /sim/randomize std_srvs/srv/Trigger > /dev/null; } && $call /brain/start std_srvs/srv/Trigger > /dev/null && \
timeout 120 ros2 topic echo --field data /brain_state std_msgs/msg/String 2> /dev/null \
| while read -r s; do case \$s in ---|IDLE) continue ;; esac; [ \"\$s\" = \"\$last\" ] || echo \"\$s\"; last=\$s; \
case \$s in DONE*|ERROR*|STOPPED*) break ;; esac; done"
    ;;
  play)
    none "$@"
    # A TTY in the container from a terminal, for the keys; a pipe keeps -T and its input is read as keys.
    tty=-T
    [ -t 0 ] && tty=""
    ros $tty "[ \"\$CONNECT4\" = true ] || { echo 'so101 play: the stack does not run the game: tools/so101 down, then CONNECT4=true tools/so101 up' >&2; exit 1; }; \
ros2 run so101_bringup connect4_play"
    ;;
  bench)
    mode="" episodes=10 bags=-
    while [ $# -gt 0 ]; do
      case $1 in
        --stub | --perception | --game) mode=$1 ;;
        -n) episodes=${2:-}; [ $# -lt 2 ] || shift ;;  # without its value: said below, not a silent exit 1
        --bags) bags=${2:-}; [ $# -lt 2 ] || shift ;;
        *) die "bench: unknown option $1" ;;
      esac
      shift
    done
    [ -n "$mode" ] || die "bench: --stub, --perception or --game"
    [[ $episodes =~ ^[1-9][0-9]*$ ]] || die "bench: -n takes a number of episodes"
    [ -n "$bags" ] && [[ $bags =~ ^[A-Za-z0-9_./-]*$ ]] || die "bench: --bags takes a plain path"
    [ "$bags" != - ] || bags=""
    what="--episodes $episodes --out /ros2_ws/eval_bench.csv"
    if [ "$mode" = --stub ]; then
      stack="ros2 launch /ros2_ws/src/so101_bringup/test/gt_stub.launch.py"  # development only (step 4.2c)
    elif [ "$mode" = --game ]; then  # the board reader is the game's perception
      stack="ros2 launch so101_bringup sim.launch.py expose_ground_truth:=true perception:=true connect4:=true"
      what="--games $episodes --out /ros2_ws/eval_games.csv"
    else
      stack="ros2 launch so101_bringup sim.launch.py expose_ground_truth:=true perception:=true"
    fi
    # One stack per domain: refuse when a so101 node of this container runs on it (ros2 node list misses the
    # container's own nodes, as a leftover bench's; "[/]" keeps pgrep from matching this command line) or nodes
    # elsewhere answer on it. The stack stops with the bench:
    # set -m puts it in its own process group, else a non-interactive shell starts it with SIGINT ignored.
    # From a terminal, a TTY in the container: Ctrl+C then stops the bench there (with exec -T it stopped only
    # the docker client, the bench went on, #58) and its lines show as they come; a pipe or CI keeps -T.
    tty=-T
    [ -t 0 ] && tty=""
    ros $tty -e ROS_DOMAIN_ID=$BENCH_DOMAIN "set -m; \
busy=\$(for p in \$(pgrep -f \"[/]lib/so101_\"); do grep -qxz ROS_DOMAIN_ID=$BENCH_DOMAIN /proc/\$p/environ && echo \$p; done); \
if [ -n \"\$busy\" ] || [ -n \"\$(ros2 node list --no-daemon --spin-time 3)\" ]; then \
echo \"so101 bench: a stack already runs on ROS domain $BENCH_DOMAIN\" >&2; exit 1; fi; \
$stack > /tmp/bench_stack.log 2>&1 & stack=\$!; trap \"kill -INT \$stack; wait \$stack\" EXIT; \
ros2 run so101_bringup evaluate $what${bags:+ --bags $bags} || { status=\$?; echo 'so101 bench: the end of its stack log:' >&2; \
tail -n 30 /tmp/bench_stack.log >&2; exit \$status; }"
    ;;
  robustness)
    case=${1:-} lighting="" episodes=""
    [[ $case =~ ^(1|2|3a|3b|4|5|g[1-8])$ ]] || die "robustness: case 1, 2, 3a, 3b, 4 or 5, or g1 to g8 for the game"
    shift
    while [ $# -gt 0 ]; do
      case $1 in
        --lighting) lighting=${2:-x x}; [ $# -lt 2 ] || shift ;;  # without its value: refused below
        -n) episodes=${2:-x}; [ $# -lt 2 ] || shift ;;
        *) die "robustness: unknown option $1" ;;
      esac
      shift
    done
    [[ $lighting =~ ^[a-z0-9_]*$ ]] || die "robustness: --lighting takes an entry of config/sim_scene.yaml (dim)"
    [[ $episodes =~ ^([1-9][0-9]*)?$ ]] || die "robustness: -n takes a number of cycles"
    # Next to the everyday stack, /joint_states once stalled for 0.5 s and the demo saw 2 drivers (13 §2)
    "$dry" || [ -z "$("${compose[@]}" ps -q control)" ] || die "robustness: the everyday stack runs, tools/so101 down first"
    run "${compose[@]}" run --rm --no-deps -e ROS_DOMAIN_ID=$ROBUSTNESS_DOMAIN control bash -lc \
      "$SOURCED && ros2 launch so101_bringup robustness_demo.launch.py case:=$case\
${lighting:+ lighting:=$lighting}${episodes:+ episodes:=$episodes}"
    ;;
  run)
    stack="" out="" chown=""
    while [ $# -gt 0 ]; do
      case $1 in
        --stack|--game)  # nodes started with & in a non-interactive shell ignore SIGINT: the container's end stops them
          game=""; [ "$1" = --stack ] || game=" connect4:=true perception:=true"  # the game: its node, the board reader
          stack="(ros2 launch so101_bringup sim.launch.py$game > /tmp/stack.log 2>&1 &) && \
timeout 120 ros2 topic echo --once /end_effector_pose geometry_msgs/msg/PoseStamped > /dev/null || { tail -n 30 /tmp/stack.log; exit 1; }; "
          [ -z "$game" ] || stack+="timeout 120 ros2 topic echo --once /connect4/grid_pose geometry_msgs/msg/PoseStamped > /dev/null \
|| { tail -n 30 /tmp/stack.log; exit 1; }; "
          ;;
        --out) out=${2:-}; [ $# -lt 2 ] || shift ;;
        -*) die "run: unknown option $1" ;;
        *) break ;;
      esac
      shift
    done
    [ $# -eq 1 ] || die "run: one command, quoted"
    [[ $out =~ ^[A-Za-z0-9_./-]*$ ]] || die "run: --out takes a plain path"
    volumes=(-v "$root:/repo:ro")
    if [ -n "$out" ]; then
      "$dry" || mkdir -p "$out"
      out=$(realpath -m "$out")
      volumes+=(-v "$out:/out")
      chown="; status=\$?; chown -R $(id -u):$(id -g) /out; exit \$status"  # the container runs as root
    fi
    tty=""
    [ -t 0 ] && tty=-t
    run docker run --rm -i ${tty:+"$tty"} --network none -e ROS_DOMAIN_ID=$RUN_DOMAIN -e MUJOCO_GL=osmesa "${volumes[@]}" \
      tek5/control bash -lc "mkdir -p /tmp/ws && cp -r /repo/ros2_ws/src /tmp/ws/ && cd /tmp/ws && \
source /opt/ros/jazzy/setup.bash && colcon build --packages-up-to $PACKAGES > /tmp/build.log 2>&1 \
|| { tail -n 30 /tmp/build.log; exit 1; }; source install/setup.bash && $stack$1$chown"
    ;;
  test)
    # In a fresh container: the tests need no stack, and the timing ones (the planner's p95) need its CPU, so stop
    # the stack first for a full run. One package at a time, as the CI: in parallel, those tests fail too.
    if [ $# -eq 0 ]; then
      fresh "cd /ros2_ws && colcon build --symlink-install --packages-up-to $PACKAGES && \
colcon test --executor sequential --packages-select $PACKAGES --event-handlers console_cohesion+ && colcon test-result --verbose"
    else
      [[ $1 =~ ^so101_[a-z0-9_]+$ ]] || die "test: a package name, e.g. so101_brain"
      package=$1
      shift
      pytest=""
      [ $# -eq 0 ] || pytest=" --pytest-args$(printf ' %q' "$@")"  # quoted: they cross a bash -lc
      # test-result on this package only: build/ keeps the other packages' results, old failures included
      fresh "cd /ros2_ws && colcon build --symlink-install --packages-select $package && \
colcon test --packages-select $package --event-handlers console_direct+$pytest && \
colcon test-result --test-result-base build/$package --verbose"
    fi
    ;;
  *) usage >&2; exit 2 ;;
esac
