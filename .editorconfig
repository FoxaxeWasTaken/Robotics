root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,xml,urdf,xacro,launch,md,json,rviz}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # two trailing spaces = Markdown line break

[Makefile]
indent_style = tab
